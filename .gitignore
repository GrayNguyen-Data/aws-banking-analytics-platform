# ========================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# ========================================================
# 3. DỮ LIỆU THÔ (LƯU TRÊN AWS S3 DATA LAKE)
# ========================================================
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
data/raw/*.zip
data/raw/*.gz
!data/raw/.gitkeep

